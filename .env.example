# Telegram Bot Token (BotFather dan olinadi)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Administratorlarning Telegram ID raqamlari (vergul bilan ajratilgan)
ADMIN_IDS=123456789

# Ma'lumotlar bazasi fayli yo'li
DATABASE_PATH=database/bilim_kutubxonasi.db

# Webhook sozlamalari (Render Web Service uchun)
# RENDER_EXTERNAL_URL Render tomonidan avtomatik beriladi,
# lekin qo'lda ham kiritish mumkin: masalan https://bilim-kutubxonasi-bot.onrender.com
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=your_custom_secret_key_here

# Server porti (Render avtomatik PORT=10000 beradi)
PORT=10000
HOST=0.0.0.0
