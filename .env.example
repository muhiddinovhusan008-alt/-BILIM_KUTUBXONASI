# Telegram Bot Token (BotFather dan olinadi)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Administratorlarning Telegram ID raqamlari (vergul bilan ajratilgan)
ADMIN_IDS=123456789,987654321

# Ma'lumotlar bazasi fayli yo'li
DATABASE_PATH=database/bilim_kutubxonasi.db

# Ixtiyoriy: Agar Telegram API ga ulanishda cheklov bo'lsa, proksi ko'rsatishingiz mumkin:
# PROXY_URL=http://user:pass@ip:port
# PROXY_URL=socks5://127.0.0.1:10808
